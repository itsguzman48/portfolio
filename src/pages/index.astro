---
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/literata/400.css';
import '@fontsource/literata/600.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import { contacto, proyectos, trayectoria, idiomas } from '../data.js';
import retrato from '../assets/retrato.jpg';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg}', { eager: true });
const imgs: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(files).map(([k, v]) => [k.split('/').pop()!.replace(/\.\w+$/, ''), v.default]),
);

const pad = (i: number) => String(i + 1).padStart(2, '0');
const desc = 'Íñigo Guzmán, técnico superior ASIR especializándose en IA y Big Data. Cinco proyectos: un SOC multi-cloud con IA, HaizeLab, desgaste de herramienta CNC, Celestial Constellation AI y LUXAI.';
const site = Astro.site ?? new URL('https://inigoguzman.vercel.app');
const og = new URL('/og.jpg', site).href;

const oficios = [
  {
    id: 'sistemas',
    titulo: 'Sistemas',
    mq: 'Sistemas · DigitalOcean · Azure · WireGuard · Docker · ',
    dur: '20s',
    texto: 'Monto la red antes que el modelo. En el SOC, los honeypots Cowrie están en DigitalOcean (Nueva York y Fráncfort) y el análisis en Azure. Entre ellos solo hay WireGuard.',
  },
  {
    id: 'medicion',
    titulo: 'Medición',
    mq: 'Medición · NO₂ · ZBE Bilbao · InfluxDB · Grafana · ',
    dur: '40s',
    texto: 'Me fío de un número si puedo decir de dónde sale. En HaizeLab fueron 332.776 registros horarios de 8 estaciones, y un contraste dentro y fuera de la ZBE de Bilbao.',
  },
  {
    id: 'modelos',
    titulo: 'Modelos',
    mq: 'Modelos · XGBoost · SHAP · Canvas · Astro · ',
    dur: '20s',
    texto: 'El modelo tiene que aguantar una pieza, un cielo o una foto que no ha visto. XGBoost con SHAP en la fresa, similitud angular en las estrellas, vídeo a partir de las fotos reales.',
  },
];

const turnIcon = `<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.2 8.2a5.2 5.2 0 1 1-1.3-3.5"/><path d="M12.2 1.6v3.4H8.8"/></svg>`;
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Íñigo Guzmán · Sistemas, cloud, datos e IA</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={site.href} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:url" content={site.href} />
  <meta property="og:title" content="Íñigo Guzmán · Sistemas, cloud, datos e IA" />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={og} />
  <meta name="theme-color" content="#f4efe8" />
  <meta name="color-scheme" content="light" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Person', name: 'Íñigo Guzmán', url: site.href,
    jobTitle: 'Técnico Superior en Administración de Sistemas Informáticos en Red',
    address: { '@type': 'PostalAddress', addressLocality: 'Getxo', addressRegion: 'Bizkaia', addressCountry: 'ES' },
    email: `mailto:${contacto.email}`, sameAs: [contacto.github, contacto.linkedin],
  })} />
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <div id="live" class="sr-only" aria-live="polite"></div>

  <header class="hdr">
    <a class="brand" href="#contenido">
      <span class="brand-full">Íñigo Guzmán</span>
      <span class="brand-short">Íñigo</span>
    </a>
    <nav class="hdr-nav" aria-label="Secciones">
      <a href="#proyectos">Proyectos</a>
      <a href="#oficio">Oficio</a>
      <a href="#recorrido">Recorrido</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <div class="hdr-actions">
      <button class="text-btn" type="button" data-copy={contacto.email}>
        <span class="btn-label">Copiar correo</span>
      </button>
      <button class="text-btn hdr-menu" type="button" data-menu aria-expanded="false" aria-controls="menu">Menú</button>
    </div>
  </header>

  <dialog id="menu" class="menu" aria-label="Secciones">
    <div class="menu-top">
      <p class="kicker">Íñigo Guzmán</p>
      <button class="text-btn" type="button" data-close>Cerrar</button>
    </div>
    <nav>
      <a href="#proyectos">Proyectos</a>
      <a href="#oficio">Oficio</a>
      <a href="#recorrido">Recorrido</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <p class="menu-mail"><a href={`mailto:${contacto.email}`}>{contacto.email}</a></p>
  </dialog>

  <main id="contenido">
    <section class="hero" aria-labelledby="nombre">
      <div class="hero-clip rise rise-title">
        <div class="hero-track">
          <h1 id="nombre">Íñigo Guzmán</h1>
          <span aria-hidden="true">Íñigo Guzmán</span>
          <span aria-hidden="true">Íñigo Guzmán</span>
          <span aria-hidden="true">Íñigo Guzmán</span>
        </div>
      </div>
      <div class="hero-grid">
        <figure class="hero-photo rise">
          <Image
            src={retrato}
            alt="Retrato de Íñigo Guzmán, sonriendo, junto a un río de agua turquesa."
            widths={[320, 520]}
            sizes="(max-width: 800px) 220px, 260px"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>{contacto.lugar}</figcaption>
        </figure>
        <div class="hero-main rise">
          <p class="lede">Soy técnico superior en ASIR y curso la especialización en IA y Big Data en CIFP Somorrostro. Me interesa llevar modelos y pipelines de datos a infraestructura real.</p>
        </div>
        <div class="hero-side rise">
          <p class="kicker">En curso</p>
          <p class="side-note">Especialización en IA y Big Data. CIFP Somorrostro, 2026–27.</p>
          <button class="text-btn" type="button" data-copy={contacto.email}>
            <span class="btn-label">Copiar correo</span>
          </button>
          <a class="mail" href={`mailto:${contacto.email}`}>{contacto.email}</a>
        </div>
      </div>
    </section>

    <section id="proyectos" aria-labelledby="proy-t">
      <header class="sec-head">
        <h2 id="proy-t">Trabajo</h2>
      </header>
      <div class="stack">
        {proyectos.map((p, i) => (
          <article class="sheet" id={p.id} data-sheet style={`--z:${i + 1}`}>
            <h3 class="sr-only" id={`${p.id}-t`}>{p.nombre}</h3>
            <div class="plate">
              <div class="flip" data-flip data-name={p.nombre} aria-labelledby={`${p.id}-t`}>
                <div class="flip-inner">
                  <div class="face face-front">
                    <div class="face-copy">
                      <div class="face-top">
                        <span class="idx">{pad(i)}</span>
                        <p class="meta">{p.meta}</p>
                      </div>
                      <p class="face-title" aria-hidden="true">{p.titulo}</p>
                      <p class="line">{p.linea}</p>
                      <button class="turn" type="button" data-turn aria-pressed="false">
                        <span>Girar ficha</span>
                        <Fragment set:html={turnIcon} />
                      </button>
                    </div>
                    <figure class="shot-main">
                      <Image src={imgs[p.img.src]} alt={p.img.alt} widths={[640, 960, 1400]} sizes="(max-width: 800px) 94vw, 42vw" loading={i === 0 ? 'eager' : 'lazy'} />
                    </figure>
                  </div>
                  <div class="face face-back">
                    <div class="back-copy">
                      <div class="back-top">
                        <span class="idx">{pad(i)}</span>
                        <p class="meta">{p.nombre}</p>
                      </div>
                      <p class="cifra">{p.cifra}</p>
                      <p class="cifra-text">{p.cifraTexto}</p>
                      <p class="detalle">{p.detalle}</p>
                      <ul class="tech" aria-label="Tecnologías">
                        {p.stack.map((s) => <li>{s}</li>)}
                      </ul>
                      <p class="links">
                        {p.enlaces.map((l) => <a href={l.u} target="_blank" rel="noopener noreferrer">{l.t}</a>)}
                      </p>
                      <button class="turn" type="button" data-turn aria-pressed="false">
                        <span>Girar ficha</span>
                        <Fragment set:html={turnIcon} />
                      </button>
                    </div>
                    <div class="gallery">
                      {p.extra.map((e) => (
                        <figure class={e.movil ? 'shot is-phone' : 'shot'}>
                          <Image src={imgs[e.src]} alt={e.alt} widths={[480, 960]} sizes="(max-width: 800px) 88vw, 36vw" loading="lazy" />
                          <figcaption>{e.pie}</figcaption>
                        </figure>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <nav class="rail" aria-label="Ir al proyecto">
      {proyectos.map((p, i) => (
        <a href={`#${p.id}`} aria-label={p.nombre}>{pad(i)}</a>
      ))}
    </nav>

    <section id="oficio" aria-labelledby="oficio-t">
      <header class="sec-head">
        <h2 id="oficio-t">Cómo trabajo</h2>
        <button class="text-btn" type="button" data-pause-mq aria-pressed="false">
          <span class="btn-label">Pausar rótulos</span>
        </button>
      </header>
      <div class="oficio-grid">
        {oficios.map((o) => (
          <article class="tile" id={o.id}>
            <h3 class="sr-only">{o.titulo}</h3>
            <div class="flip" data-flip data-name={o.titulo}>
              <div class="flip-inner">
                <div class="face face-front">
                  <div class="mq" style={`--mq:${o.dur}`}>
                    <div class="mq-track">
                      <span>{o.mq}{o.mq}</span>
                      <span aria-hidden="true">{o.mq}{o.mq}</span>
                    </div>
                  </div>
                  <p class="tile-word" aria-hidden="true">{o.titulo}</p>
                  <button class="turn" type="button" data-turn aria-pressed="false">
                    <span>Girar ficha</span>
                    <Fragment set:html={turnIcon} />
                  </button>
                </div>
                <div class="face face-back">
                  <p class="kicker">{o.titulo}</p>
                  <p class="tile-body">{o.texto}</p>
                  <button class="turn" type="button" data-turn aria-pressed="false">
                    <span>Girar ficha</span>
                    <Fragment set:html={turnIcon} />
                  </button>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="recorrido" aria-labelledby="rec-t">
      <header class="sec-head">
        <h2 id="rec-t">Recorrido</h2>
        <p class="sec-note">{idiomas}</p>
      </header>
      <ol class="cv">
        {trayectoria.map((t) => (
          <li>
            <span class="y">{t.a}</span>
            <span class="tt">{t.t}</span>
            <p class="d">{t.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="contacto" class="contact" aria-labelledby="con-t">
      <header class="sec-head is-contact">
        <p class="kicker">{contacto.lugar}</p>
        <h2 id="con-t">Escríbeme</h2>
        <p class="sec-note">Si quieres ver cómo está montado un proyecto, escríbeme.</p>
      </header>
      <a class="email-xl" href={`mailto:${contacto.email}`}>{contacto.email}</a>
      <div class="contact-actions">
        <button class="text-btn" type="button" data-copy={contacto.email}>
          <span class="btn-label">Copiar correo</span>
        </button>
        <a href={contacto.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={contacto.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="/cv.pdf" download="CV-Inigo-Guzman.pdf">Descargar CV</a>
      </div>
      <p class="lang">{idiomas}. {contacto.lugar}.</p>
    </section>
  </main>

  <footer class="colophon">
    <p class="colo-name">Íñigo Guzmán</p>
    <p class="colo-sub">Sistemas, cloud, datos e IA</p>
  </footer>

  <script is:inline>
    document.documentElement.classList.add('js');
    requestAnimationFrame(function () {
      document.documentElement.classList.add('is-ready');
    });
  </script>
  <script>
    import { start } from '../scripts/motion.js';
    start();
  </script>
</body>
</html>
