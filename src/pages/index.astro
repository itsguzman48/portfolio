---
import '@fontsource/im-fell-english-sc/400.css';
import '@fontsource/im-fell-english/400-italic.css';
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import Toc from '../components/Toc.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Chapter from '../components/Chapter.astro';
import { contacto, proyectos, luxai as lux, experiencia, formacion, herramientas, idiomas } from '../data.js';
import retrato from '../assets/retrato.jpg';
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg}', { eager: true });
const imgs = Object.fromEntries(Object.entries(files).map(([k, v]) => [k.split('/').pop()!.replace(/\.\w+$/, ''), v.default]));
const laminas = [...proyectos.map((p) => ({ ...p, img: p.laminas[0].img, alt: p.laminas[0].alt })), { ...lux, alt: 'Portada de luxaivideo.com.' }];
const desc = 'Íñigo Guzmán. Técnico Superior ASIR especializándose en IA y Big Data. Sistemas, cloud, pipelines de datos e IA aplicada a infraestructura real. Getxo, Bizkaia.';
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Íñigo Guzmán · Sistemas, cloud, datos e IA</title>
  <meta name="description" content={desc} />
  <meta property="og:title" content="Íñigo Guzmán" />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#e4e1d5" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script is:inline>
    try { const t = localStorage.getItem('papel'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>

  <header class="cover">
    <figure class="frontis">
      <div class="frontis-frame">
        <Image src={retrato} alt="Retrato de Íñigo Guzmán, sonriendo, junto a un río de agua turquesa." widths={[220, 352]} sizes="(max-width: 64rem) 11rem, 16rem" loading="eager" />
      </div>
      <figcaption>El autor</figcaption>
    </figure>
    <div class="cover-text">
      <p class="folio" aria-hidden="true">ed. MMXXVI</p>
      <h1 class="name"><span>Íñigo</span><span>Guzmán</span></h1>
      <p class="subtitle">Sistemas, cloud, datos <em>&amp;</em> IA</p>
      <p class="lede">Vengo de administrar servidores y ahora me especializo en IA y Big Data en el CIFP Somorrostro. Me interesa la parte que suele quedarse fuera de las demos: llevar los modelos y los datos a una infraestructura que funcione de verdad.</p>
      <p class="cover-links">
        <a href={`mailto:${contacto.email}`}>Email</a>
        <a href={contacto.github} target="_blank" rel="noopener">GitHub</a>
        <a href={contacto.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href="/cv.pdf" download="CV-Inigo-Guzman.pdf">CV en PDF ↓</a>
        <ThemeToggle />
      </p>
    </div>
  </header>

  <section class="laminas" aria-labelledby="laminas-h">
    <div class="laminas-head">
      <h2 id="laminas-h">Índice de láminas</h2>
      <span>Cinco trabajos · {contacto.lugar}</span>
    </div>
    <ol class="lam-grid">
      {laminas.map((l, i) => (
        <li class={`lam lam-${l.id}`}>
          <a href={`#${l.id}`}>
            <span class="lam-img"><Image src={imgs[l.img]} alt="" widths={[480, 720, 960]} sizes="(max-width: 40rem) 40vw, (max-width: 64rem) 46vw, 30rem" loading={i < 3 ? 'eager' : 'lazy'} /></span>
            <span class="lam-cap"><span class="lam-t">{l.titulo}</span><span class="lam-n">Lám. {l.n}</span></span>
            <span class="lam-line">{l.linea}</span>
            <span class="lam-stack">{l.corto}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <div class="running" aria-hidden="true" data-running>
    <a href="#" tabindex="-1">Íñigo Guzmán</a>
    <span data-running-ch>Índice de láminas</span>
  </div>

  <main id="contenido">
    <Chapter id="sobre-mi" n="I" title="Sobre mí">
      <div class="prose">
        <p class="dropcap">Soy técnico superior en Administración de Sistemas Informáticos en Red, y este curso hago la especialización en Inteligencia Artificial y Big Data. Mi base es la de un sysadmin: Linux, Windows Server, redes, scripting. En 2026 pasé tres meses de Erasmus en Cosenza, en Italia, como técnico de sistemas en Internet-Idee.</p>
        <p>Casi todo lo que hago acaba teniendo la misma forma: algo que recoge datos, algo que los guarda bien, un modelo que saca una conclusión y un panel donde alguien la puede leer. Me gusta que las cifras sean honestas, aunque salgan menos espectaculares.</p>
        <p>Fuera de la pantalla edito vídeo y vuelo dron. Tengo carné B, coche propio y ganas de moverme.</p>
      </div>
    </Chapter>

    <Chapter id="proyectos" n="II" title="Proyectos">
      <p class="intro">Cuatro trabajos de 2026, de la red a la estadística. Todos tienen el código abierto en GitHub.</p>
      <ol class="works">
        {proyectos.map((p) => (
          <li class="work" id={p.id}>
            <div class={`gallery ${p.movil ? 'gallery-movil' : ''}`}>
              {p.laminas.map((l, j) => (
                <figure class={j === 0 ? 'g-main' : 'g-sub'}>
                  <span class="plate"><Image src={imgs[l.img]} alt={l.alt} widths={j === 0 && !p.movil ? [720, 1080, 1600] : [400, 640, 900]} sizes={j === 0 ? '(max-width: 64rem) 94vw, 56rem' : '(max-width: 40rem) 46vw, 28rem'} /></span>
                  <figcaption><span>{p.n}{String.fromCharCode(97 + j)}</span> {l.pie}</figcaption>
                </figure>
              ))}
            </div>
            <div class="work-body">
              <div class="work-main">
                <div class="caption"><h3>{p.titulo}</h3><span>Lám. {p.n}</span></div>
                <p class="figure"><strong>{p.cifra}</strong> <span>{p.cifraTexto}</span></p>
                {p.texto.map((t) => <p class="work-text">{t}</p>)}
                {p.cita && <blockquote class="cita"><p>“{p.cita}”</p><footer>— Del informe de HaizeLab</footer></blockquote>}
              </div>
              <dl class="ficha">
                <div><dt>Contexto</dt><dd>{p.meta}</dd></div>
                <div><dt>Con</dt><dd><em>{p.stack}</em></dd></div>
                <div><dt>Ver</dt><dd class="links">{p.enlaces.map((e) => <a href={e.u} target="_blank" rel="noopener">{e.t} ↗</a>)}</dd></div>
              </dl>
            </div>
          </li>
        ))}
      </ol>
    </Chapter>

    <Chapter id="luxai" n="III" title="LUXAI">
      <p class="intro">Proyecto propio.</p>
      <div class="gallery gallery-movil">
        <figure class="g-main"><a class="plate" href="https://luxaivideo.com" target="_blank" rel="noopener"><Image src={imgs.luxai} alt="Portada de luxaivideo.com: una villa al atardecer con el titular «Vuestras fotos ya tienen una película dentro»." widths={[720, 1080, 1440]} sizes="(max-width: 64rem) 94vw, 42rem" /></a><figcaption><span>5a</span> luxaivideo.com, en escritorio</figcaption></figure>
        <figure class="g-sub"><a class="plate" href="https://luxaivideo.com" target="_blank" rel="noopener" tabindex="-1"><Image src={imgs.luxai_movil} alt="La misma portada en un móvil." widths={[400, 640]} sizes="14rem" /></a><figcaption><span>5b</span> Y en el móvil</figcaption></figure>
      </div>
      <div class="work-body">
        <div class="work-main">
          <div class="caption"><h3>LUXAI Video</h3><a href="https://luxaivideo.com" target="_blank" rel="noopener">luxaivideo.com ↗</a></div>
          <p class="work-text">LUXAI convierte las fotos de villas y alquileres de lujo en vídeos de estilo aéreo, como grabados con dron, pero generados con IA (Google Flow). Sin rodaje ni permisos de vuelo: el cliente manda entre 5 y 15 fotos y en 72 horas tiene sus vídeos para portales, web y redes.</p>
          <p class="work-text">La web también es mía: multipágina, en español e inglés, con Astro y TypeScript.</p>
        </div>
        <dl class="ficha">
          <div><dt>De las fotos al vídeo</dt><dd>72 h</dd></div>
          <div><dt>Fotos de partida</dt><dd>5–15</dd></div>
          <div><dt>Formatos</dt><dd>16:9 · 9:16</dd></div>
          <div><dt>Ver</dt><dd class="links"><a href="https://luxaivideo.com" target="_blank" rel="noopener">La web ↗</a><a href="https://github.com/itsguzman48/luxaivideo-web" target="_blank" rel="noopener">Repositorio ↗</a></dd></div>
        </dl>
      </div>
    </Chapter>

    <Chapter id="trayectoria" n="IV" title="Trayectoria">
      <h3 class="list-h">Experiencia</h3>
      <ul class="ledger">
        {experiencia.map((e) => <li><div><span class="l-t">{e.t}</span><span class="l-d">{e.d}</span></div><span class="l-a">{e.a}</span></li>)}
      </ul>
      <h3 class="list-h">Formación</h3>
      <ul class="ledger">
        {formacion.map((e) => <li><div><span class="l-t">{e.t}</span><span class="l-d">{e.d}</span></div><span class="l-a">{e.a}</span></li>)}
      </ul>
    </Chapter>

    <Chapter id="herramientas" n="V" title="Herramientas">
      <div class="tools">
        {herramientas.map((h) => (
          <div><h3 class="list-h">{h.g}</h3><p class="tool-list">{h.l.join(', ')}.</p></div>
        ))}
      </div>
      <h3 class="list-h">Idiomas</h3>
      <ul class="ledger compact">
        {idiomas.map((e) => <li><div><span class="l-t">{e.t}</span></div><span class="l-a">{e.a}</span></li>)}
      </ul>
      <h3 class="list-h">Además</h3>
      <p class="tool-list">Edición audiovisual y dron propio. Carné B, coche propio y disponibilidad para viajar.</p>
    </Chapter>

    <Chapter id="contacto" n="VI" title="Contacto">
      <div class="prose center">
        <p>Tengo disponibilidad para la FP Dual intensiva (diciembre de 2026 / febrero de 2027). Si tienes servidores, datos o un modelo que hay que poner a funcionar, escríbeme.</p>
      </div>
      <p class="mail"><a href={`mailto:${contacto.email}`}>{contacto.email}</a></p>
      <p class="clock" data-clock hidden>En Getxo son las <span></span>.</p>
    </Chapter>
  </main>

  <footer class="foot">
    <p class="foot-links">
      <a href={`mailto:${contacto.email}`}>Email</a>
      <a href={contacto.github} target="_blank" rel="noopener">GitHub</a>
      <a href={contacto.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href="/cv.pdf" download="CV-Inigo-Guzman.pdf">CV</a>
    </p>
    <Toc label="Índice (pie)" />
    <div class="edition">
      <span>ed. MMXXVI · Íñigo Guzmán</span>
      <ThemeToggle />
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
      b.addEventListener('click', () => {
        const dark = (root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'oscuro' : 'claro')) === 'oscuro';
        root.dataset.theme = dark ? 'claro' : 'oscuro';
        try { localStorage.setItem('papel', root.dataset.theme); } catch (e) {}
      })
    );
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    if (clock) {
      const span = clock.querySelector('span')!;
      const tick = () => (span.textContent = new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' }).format(new Date()));
      tick(); clock.hidden = false; setInterval(tick, 30000);
    }
    const running = document.querySelector<HTMLElement>('[data-running]');
    const chLabel = document.querySelector<HTMLElement>('[data-running-ch]');
    const cover = document.querySelector('.cover');
    if (running && chLabel && cover && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => running.classList.toggle('show', !e.isIntersecting), { threshold: 0.05 }).observe(cover);
      const chIo = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) {
          const n = e.target.querySelector('.chapter-n')?.textContent ?? '';
          const t = e.target.querySelector('.chapter-h')?.textContent ?? '';
          chLabel.textContent = `${t} · ${n}`;
        }
      }), { rootMargin: '-45% 0px -50% 0px' });
      document.querySelectorAll('.chapter').forEach((c) => chIo.observe(c));
    }
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.chapter, .work, .laminas').forEach((el) => { el.classList.add('rise'); io.observe(el); });
    }
  </script>
</body>
</html>
