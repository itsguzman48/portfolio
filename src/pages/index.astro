---
import '@fontsource/gloock/400.css';
import '@fontsource-variable/sora/wght.css';
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import { contacto, proyectos, trayectoria, idiomas } from '../data.js';
import retrato from '../assets/retrato.jpg';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg}', { eager: true });
const imgs: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(files).map(([k, v]) => [k.split('/').pop()!.replace(/\.\w+$/, ''), v.default]),
);

// Texturas para WebGL: webp ligeros generados en el build.
const gl = await Promise.all(
  proyectos.map(async (p) => {
    const src = imgs[p.img.src];
    const t = await getImage({ src, width: Math.min(1400, src.width), format: 'webp', quality: 78 });
    return { id: p.id, bg: p.bg, ink: p.ink, tex: t.src, w: src.width, h: src.height };
  }),
);

const n = proyectos.length;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const desc = 'Íñigo Guzmán, técnico superior ASIR especializándose en IA y Big Data. Cinco proyectos: un SOC multi-cloud con IA, HaizeLab, desgaste de herramienta CNC, Celestial Constellation AI y LUXAI.';
const site = Astro.site ?? new URL('https://inigoguzman.vercel.app');
const og = new URL('/og.jpg', site).href;
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Íñigo Guzmán · Sistemas, cloud, datos e IA</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={site.href} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:url" content={site.href} />
  <meta property="og:title" content="Íñigo Guzmán · Sistemas, cloud, datos e IA" />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={og} />
  <meta name="theme-color" content={proyectos[0].bg} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" as="image" href={gl[0].tex} type="image/webp" fetchpriority="high" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Person', name: 'Íñigo Guzmán', url: site.href,
    jobTitle: 'Técnico Superior en Administración de Sistemas Informáticos en Red',
    address: { '@type': 'PostalAddress', addressLocality: 'Getxo', addressRegion: 'Bizkaia', addressCountry: 'ES' },
    email: `mailto:${contacto.email}`, sameAs: [contacto.github, contacto.linkedin],
  })} />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body style={`--bg:${proyectos[0].bg};--ink:${proyectos[0].ink}`}>
  <canvas class="gl" aria-hidden="true"></canvas>

  <header class="hdr">
    <a class="hdr-name" href="/" data-home>Íñigo Guzmán</a>
    <button class="hdr-back" type="button" data-close>
      <svg viewBox="0 0 16 10" aria-hidden="true"><path d="M5 1 1 5l4 4M1 5h14" /></svg>Volver
    </button>
    <a class="hdr-about" href="#sobre-mi" data-about>Sobre mí</a>
  </header>

  <main id="contenido">
    <h1 class="sr-only">Íñigo Guzmán: sistemas, cloud, datos e IA. Proyectos seleccionados.</h1>
    <ol class="slides" aria-label="Proyectos">
      {proyectos.map((p, i) => (
        <li class="slide" data-i={i} style={`--bg:${p.bg};--ink:${p.ink}`} aria-roledescription="proyecto" aria-label={`${i + 1} de ${n}: ${p.nombre}`}>
          <a class="slide-media" href={`#${p.id}`} data-open={p.id} tabindex="-1" aria-hidden="true">
            <Image src={imgs[p.img.src]} alt="" widths={[480, 800, 1200]} sizes="(max-width: 820px) 92vw, 40vw" loading={i === 0 ? 'eager' : 'lazy'} />
          </a>
          <span class="slide-thumb" aria-hidden="true">
            <Image src={imgs[p.thumb.src]} alt="" widths={[240, 400]} sizes="200px" loading="lazy" />
          </span>
          <div class="slide-txt">
            <p class="slide-meta"><span>{pad(i)}</span>{p.meta}</p>
            <h2 class="slide-title">{p.titulo}</h2>
            <p class="slide-line">{p.linea}</p>
            <a class="slide-open" href={`#${p.id}`} data-open={p.id}>
              Ver proyecto <svg viewBox="0 0 16 10" aria-hidden="true"><path d="M11 1l4 4-4 4M15 5H1" /></svg>
            </a>
          </div>
        </li>
      ))}
    </ol>

    <nav class="ticks" aria-label="Ir al proyecto">
      {proyectos.map((p, i) => (
        <button type="button" data-go={i} aria-label={p.nombre} aria-current={i === 0 ? 'true' : undefined}><span></span></button>
      ))}
    </nav>
    <p class="count" aria-hidden="true"><span data-count>01</span> / {pad(n - 1)}</p>
    <button class="hit" type="button" tabindex="-1" aria-hidden="true" data-hit></button>
  </main>

  {proyectos.map((p, i) => (
    <article class="case" id={p.id} data-case={i} aria-labelledby={`${p.id}-t`} style={`--accent:${p.bg}`}>
      <div class="case-txt">
        <p class="case-meta"><span>{pad(i)}</span>{p.meta}</p>
        <h2 class="case-title" id={`${p.id}-t`}>{p.nombre}</h2>
        <p class="case-num"><strong>{p.cifra}</strong><span>{p.cifraTexto}</span></p>
        <p class="case-line">{p.detalle}</p>
        <ul class="case-stack" aria-label="Tecnologías">{p.stack.map((s) => <li>{s}</li>)}</ul>
        <p class="case-links">
          {p.enlaces.map((l) => <a href={l.u} target="_blank" rel="noopener">{l.t}<svg viewBox="0 0 10 10" aria-hidden="true"><path d="M2 8 8 2M3 2h5v5" /></svg></a>)}
        </p>
      </div>
      <div class="case-visual">
        <figure class="case-media" data-media>
          <Image src={imgs[p.img.src]} alt={p.img.alt} widths={[600, 900, 1300]} sizes="(max-width: 820px) 92vw, 52vw" loading="lazy" />
        </figure>
        <div class="case-extra">
          {p.extra.map((e) => (
            <figure class={e.movil ? 'is-movil' : ''}>
              <Image src={imgs[e.src]} alt={e.alt} widths={[320, 640]} sizes="(max-width: 820px) 44vw, 16vw" loading="lazy" />
              <figcaption>{e.pie}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </article>
  ))}

  <section class="about" id="sobre-mi" aria-labelledby="about-t">
    <div class="about-photo">
      <Image src={retrato} alt="Retrato de Íñigo Guzmán, sonriendo, junto a un río de agua turquesa." widths={[352]} sizes="(max-width: 820px) 60vw, 22rem" loading="lazy" />
    </div>
    <div class="about-txt">
      <h2 class="about-title" id="about-t">Hola,<br />soy Íñigo</h2>
      <p class="about-bio">Sysadmin especializándome en IA y Big Data. Me interesa llevar modelos y pipelines de datos a infraestructura real.</p>
      <ul class="about-cv">
        {trayectoria.map((t) => <li><span class="y">{t.a}</span><span class="t">{t.t}</span><span class="d">{t.d}</span></li>)}
      </ul>
      <p class="about-lang">{idiomas} · {contacto.lugar}</p>
      <p class="about-links">
        <a href={contacto.github} target="_blank" rel="noopener">GitHub</a>
        <a href={contacto.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href="/cv.pdf" download="CV-Inigo-Guzman.pdf">Descargar CV</a>
      </p>
    </div>
    <a class="about-mail" href={`mailto:${contacto.email}`}>{contacto.email}</a>
  </section>

  <script type="application/json" id="gl-data" set:html={JSON.stringify(gl)} />
  <script>
    import { start } from '../scripts/app.js';
    start();
  </script>
</body>
</html>
