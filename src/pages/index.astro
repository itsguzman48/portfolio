---
import '@fontsource/gloock/400.css';
import '@fontsource-variable/sora/wght.css';
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import { contacto, proyectos, trayectoria, idiomas, foco } from '../data.js';
import retrato from '../assets/retrato.jpg';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg}', { eager: true });
const imgs: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(files).map(([k, v]) => [k.split('/').pop()!.replace(/\.\w+$/, ''), v.default]),
);

// Texturas WebGL: webp ligeros generados en el build.
const gl = await Promise.all(
  proyectos.map(async (p) => {
    const src = imgs[p.img.src];
    const t = await getImage({ src, width: Math.min(1400, src.width), format: 'webp', quality: 76 });
    return { id: p.id, bg: p.bg, ink: p.ink, tex: t.src, w: src.width, h: src.height };
  }),
);
// Miniaturas de la tarjeta (abajo a la izquierda).
const thumbs = await Promise.all(
  proyectos.map(async (p) => (await getImage({ src: imgs[p.thumb.src], width: 440, format: 'webp', quality: 74 })).src),
);

const usadas = new Set(proyectos.flatMap((p) => p.stack));
for (const bloque of foco) {
  for (const tool of bloque.tools) {
    if (!usadas.has(tool)) throw new Error(`«${tool}» no está en el stack de ningún proyecto`);
  }
}

const n = proyectos.length;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const desc = 'Íñigo Guzmán, técnico superior ASIR especializándose en IA y Big Data. Cinco proyectos: un SOC multi-cloud con IA, HaizeLab, desgaste de herramienta CNC, Celestial Constellation AI y LUXAI.';
const site = Astro.site ?? new URL('https://inigoguzman.vercel.app');
const og = new URL('/og.jpg', site).href;
const arrow = '<svg viewBox="0 0 18 12" aria-hidden="true"><path d="M12 1l5 5-5 5M17 6H1" /></svg>';
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Íñigo Guzmán · Sistemas, cloud, datos e IA</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={site.href} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:url" content={site.href} />
  <meta property="og:title" content="Íñigo Guzmán · Sistemas, cloud, datos e IA" />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={og} />
  <meta name="theme-color" content="#0b0b0b" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" as="image" href={gl[0].tex} type="image/webp" fetchpriority="high" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Person', name: 'Íñigo Guzmán', url: site.href,
    jobTitle: 'Técnico Superior en Administración de Sistemas Informáticos en Red',
    address: { '@type': 'PostalAddress', addressLocality: 'Getxo', addressRegion: 'Bizkaia', addressCountry: 'ES' },
    email: `mailto:${contacto.email}`, sameAs: [contacto.github, contacto.linkedin],
  })} />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body style={`--bg:${proyectos[0].bg};--ink:${proyectos[0].ink}`}>
  <canvas class="gl" aria-hidden="true"></canvas>
  <div class="bgdom" aria-hidden="true"></div>

  <div class="loader" aria-hidden="true">
    <p class="loader-name"><span>Íñigo Guzmán</span></p>
    <p class="loader-role"><span>Sistemas · Cloud · Datos e IA</span></p>
    <p class="loader-card">Técnico Superior en ASIR. Ahora, especialización en IA y Big Data en CIFP Somorrostro.</p>
    <span class="loader-line"></span>
  </div>

  <header class="hdr">
    <a class="hdr-name" href="/" data-home>Íñigo Guzmán</a>
    <button class="hdr-back" type="button" data-close>
      <svg viewBox="0 0 18 12" aria-hidden="true"><path d="M6 1 1 6l5 5M1 6h16" /></svg>Volver
    </button>
    <a class="hdr-about" href="#sobre-mi" data-about>Sobre mí</a>
  </header>

  <main id="contenido" class="home">
    <h1 class="sr-only">Íñigo Guzmán: sistemas, cloud, datos e IA. Proyectos seleccionados.</h1>
    <div class="track" aria-hidden="true">
      <div class="track-in">
        {proyectos.map((p, i) => (
          <a class="still" href={`#${p.id}`} data-open={i} tabindex="-1" data-i={i} style={`--i:${i}`}>
            <Image src={imgs[p.img.src]} alt="" widths={[480, 800, 1200]} sizes="(max-width: 820px) 88vw, 46vw" loading={i < 2 ? 'eager' : 'lazy'} />
          </a>
        ))}
      </div>
    </div>
    <ol class="titles" aria-label="Proyectos">
      {proyectos.map((p, i) => (
        <li class="t" data-i={i} style={`--bg:${p.bg};--ink:${p.ink}`} aria-roledescription="proyecto" aria-label={`${i + 1} de ${n}: ${p.nombre}`}>
          <p class="t-meta"><span>{pad(i)}</span>{p.meta}</p>
          <h2 class="t-title">{p.titulo}</h2>
          <p class="t-line">{p.linea}</p>
          <a class="t-open" href={`#${p.id}`} data-open={i}>Ver proyecto <Fragment set:html={arrow} /></a>
        </li>
      ))}
    </ol>

    <div class="card" aria-hidden="true">
      <div class="card-in">
        <span class="card-face"><img alt="" src={thumbs[0]} width="440" height="259" decoding="async" /></span>
        <span class="card-face is-back"><img alt="" src={thumbs[1]} width="440" height="259" decoding="async" /></span>
      </div>
    </div>

    <nav class="dots" aria-label="Ir al proyecto">
      {proyectos.map((p, i) => (
        <button type="button" data-go={i} aria-label={p.nombre} aria-current={i === 0 ? 'true' : undefined}><em class="dl" aria-hidden="true">{p.nombre}</em><span></span></button>
      ))}
    </nav>
  </main>

  {proyectos.map((p, i) => (
    <article class="case" id={p.id} data-case={i} aria-labelledby={`${p.id}-t`} style={`--bg:${p.bg};--ink:${p.ink}`}>
      <div class="case-hero">
        <p class="case-meta"><span>{pad(i)}</span>{p.meta}</p>
        <h2 class="case-title" id={`${p.id}-t`}><span>{p.nombre}</span></h2>
        <figure class="case-still"><Image src={imgs[p.img.src]} alt={p.img.alt} widths={[600, 900, 1300]} sizes="(max-width: 820px) 88vw, 46vw" loading="lazy" /></figure>
        <span class="case-scroll" aria-hidden="true"><svg viewBox="0 0 12 16"><path d="M6 1v14M1 10l5 5 5-5" /></svg></span>
      </div>
      <div class="case-body">
        <div class="case-intro">
          <p class="case-num"><strong>{p.cifra}</strong><span>{p.cifraTexto}</span></p>
          <div>
            <p class="case-line">{p.detalle}</p>
            <ul class="case-stack" aria-label="Tecnologías">{p.stack.map((s) => <li>{s}</li>)}</ul>
            <p class="case-links">
              {p.enlaces.map((l) => <a href={l.u} target="_blank" rel="noopener">{l.t}<svg viewBox="0 0 10 10" aria-hidden="true"><path d="M2 8 8 2M3 2h5v5" /></svg></a>)}
            </p>
          </div>
        </div>
        <div class="case-extra">
          {p.extra.map((e) => (
            <figure class={e.movil ? 'is-movil' : ''}>
              <Image src={imgs[e.src]} alt={e.alt} widths={[480, 900]} sizes="(max-width: 820px) 88vw, 40vw" loading="lazy" />
              <figcaption>{e.pie}</figcaption>
            </figure>
          ))}
        </div>
        <button class="case-next" type="button" data-next={(i + 1) % n}>
          <span>Siguiente proyecto</span><strong>{proyectos[(i + 1) % n].titulo}</strong>
        </button>
      </div>
    </article>
  ))}
  <div class="cover" aria-hidden="true"></div>

  <section class="about" id="sobre-mi" aria-labelledby="about-t">
    <div class="about-photo">
      <div class="about-frame">
        <Image src={retrato} alt="Retrato de Íñigo Guzmán, sonriendo, junto a un río de agua turquesa." widths={[352]} sizes="(max-width: 820px) 78vw, 26rem" loading="lazy" />
        <p class="about-shot" aria-hidden="true">Retrato</p>
      </div>
    </div>
    <div class="about-txt">
      <p class="about-kicker"><span>Sobre mí</span>{contacto.lugar}</p>
      <h2 class="about-title" id="about-t">Hola,<br />soy Íñigo</h2>
      <p class="about-deck">Sysadmin especializándome en IA y Big Data.</p>
      <p class="about-bio">Me interesa llevar modelos y pipelines de datos a infraestructura real.</p>

      <div class="about-block">
        <p class="about-label">Lo que hago</p>
        <ul class="about-foco">
          {foco.map((f, i) => (
            <li>
              <span class="about-foco-n">{pad(i)}</span>
              <h3>{f.t}</h3>
              <p>{f.d}</p>
              <ul class="about-tools">
                {f.tools.map((tool) => <li>{tool}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>

      <div class="about-block">
        <p class="about-label">Trayectoria</p>
        <ol class="about-cv">
          {trayectoria.map((t) => (
            <li class={t.d.includes('en curso') ? 'is-now' : undefined}>
              <span class="y">{t.a}</span>
              <span class="tt">{t.t}</span>
              <span class="d">{t.d}</span>
            </li>
          ))}
        </ol>
      </div>

      <ul class="about-idiomas" aria-label="Idiomas">
        {idiomas.map((idioma) => <li><span>{idioma.nombre}</span>{idioma.nivel}</li>)}
      </ul>
      <p class="about-links">
        <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
        <a href={contacto.github} target="_blank" rel="noopener">GitHub</a>
        <a href={contacto.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href="/cv.pdf" download="CV-Inigo-Guzman.pdf">Descargar CV</a>
      </p>
    </div>
  </section>

  <script type="application/json" id="gl-data" set:html={JSON.stringify({ items: gl, thumbs })} />
  <script>
    import { start } from '../scripts/app.js';
    start();
  </script>
</body>
</html>
